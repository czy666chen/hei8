{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hei8-r3-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hei8-r3-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "APP_ENV": "local"
  },
  "env": {
    "local": {
      "name": "hei8-r3-local",
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hei8-r3-local",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "./migrations"
        }
      ],
      "vars": {
        "APP_ENV": "local"
      }
    },
    "preview": {
      "name": "hei8-r3-preview",
      "triggers": { "crons": ["17 3 * * *"] },
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hei8-r3-preview",
          "database_id": "295f09e6-672a-48d5-9e5f-ca431876ad96",
          "migrations_dir": "./migrations"
        }
      ],
      "vars": {
        "APP_ENV": "preview"
      }
    },
    "production": {
      "name": "hei8-r3-production",
      "triggers": { "crons": ["17 3 * * *"] },
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hei8-r3-production",
          "database_id": "37ecaa17-41a2-4ca6-ab4f-9d37b0bdb5d4",
          "migrations_dir": "./migrations"
        }
      ],
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
